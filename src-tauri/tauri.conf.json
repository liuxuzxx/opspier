{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpsPier",
  "version": "0.1.8",
  "identifier": "com.aic.ops",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpsPier · 运维工作台",
        "width": 1460,
        "height": 960,
        "minWidth": 1040,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/ops-32.png",
      "icons/ops-128.png",
      "icons/ops-256.png"
    ]
  }
}
